From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Morris <masonmorris8@gmail.com>
Date: Thu, 12 Nov 2026 01:20:49 -0500
Subject: [PATCH 3/8] Measure the PannerNode cone angle from the source to the
 listener

The cone angle used the listener-to-source vector, so a source facing the
listener got the outer-cone gain and one facing away got full gain. The
spec and Chromium measure the angle between the source orientation and the
source-to-listener vector.
---
 src/spatial.rs | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/spatial.rs b/src/spatial.rs
index 10e3449..9db2067 100644
--- a/src/spatial.rs
+++ b/src/spatial.rs
@@ -286,7 +286,8 @@ pub fn angle(
     }
     let normalized_source_orientation = vec3_normalized(source_orientation);
 
-    let relative_pos = vec3_sub(source_position, listener_position);
+    // the cone opens along the orientation, so measure from the source to the listener
+    let relative_pos = vec3_sub(listener_position, source_position);
     // Handle degenerate case if source and listener are at the same point.
     if vec3_square_len(relative_pos) <= f32::MIN_POSITIVE {
         return 0.;
@@ -383,6 +384,15 @@ mod tests {
         assert_float_eq!(angle, 90., abs <= 0.);
     }
 
+    #[test]
+    fn angle_source_facing_listener() {
+        let pos = [1., 0., 0.];
+        let orientation = [-1., 0., 0.];
+        let angle = angle(pos, orientation, LP);
+
+        assert_float_eq!(angle, 0., abs <= 0.);
+    }
+
     #[test]
     fn test_angle_abs_value() {
         let pos = [1., 0., 0.];
