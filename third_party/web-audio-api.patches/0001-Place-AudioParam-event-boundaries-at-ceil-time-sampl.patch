From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Morris <masonmorris8@gmail.com>
Date: Thu, 12 Nov 2026 01:18:00 -0500
Subject: [PATCH 1/10] Place AudioParam event boundaries at ceil(time *
 sampleRate)

Event boundaries rounded to the nearest frame, so a setValueAtTime at a
fractional sample time took effect one frame early. Per-frame times summed
dt, which drifts below exact frame times, so a curve starting exactly on a
frame started one frame late. Chromium places each boundary at
ceil(time * sampleRate), counted from the context's first frame. Do the
same, and compute each frame's time from its index.
---
 src/param.rs | 91 +++++++++++++++++++++++++++++++---------------------
 1 file changed, 55 insertions(+), 36 deletions(-)

diff --git a/src/param.rs b/src/param.rs
index 9008466..c587d67 100644
--- a/src/param.rs
+++ b/src/param.rs
@@ -691,6 +691,34 @@ struct BlockInfos {
     next_block_time: f64,
 }
 
+impl BlockInfos {
+    fn rate(&self) -> f64 {
+        let rate = 1. / self.dt;
+        let whole = rate.round();
+        if (rate - whole).abs() < 1e-6 {
+            whole
+        } else {
+            rate
+        }
+    }
+
+    // Index in this block of the first frame at or after `time`. Chromium
+    // places event boundaries at `ceil(time * sampleRate)`, counted from the
+    // context's first frame, so a change at a fractional sample time lands
+    // on the next frame.
+    fn index_at(&self, time: f64) -> usize {
+        let rate = self.rate();
+        ((time * rate).ceil() - (self.block_time * rate).round()).max(0.) as usize
+    }
+
+    // Time of frame `index` in this block, from the frame count rather than
+    // by summing `dt`, which drifts below exact frame times.
+    fn time_at(&self, index: usize) -> f64 {
+        let rate = self.rate();
+        ((self.block_time * rate).round() + index as f64) / rate
+    }
+}
+
