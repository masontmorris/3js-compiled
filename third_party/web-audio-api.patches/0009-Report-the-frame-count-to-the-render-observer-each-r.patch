From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Morris <masonmorris8@gmail.com>
Date: Thu, 12 Nov 2026 12:29:21 -0500
Subject: [PATCH 9/9] Report the frame count to the render observer each render
 quantum

An embedder that serves currentTime from memory its control thread reads,
rather than through a call into the engine, needs the frame count each
time it changes. RenderObserver::frame() sees it each time a render
quantum begins, the value current_time() reads from then on, so a value
published there advances by render quantum, as in Chrome. It has a
default that does nothing, so existing observers are unchanged.
---
 src/render/thread.rs | 15 +++++++++++----
 src/stats.rs         |  4 ++++
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/render/thread.rs b/src/render/thread.rs
index a3d0dcb..66f6432 100644
--- a/src/render/thread.rs
+++ b/src/render/thread.rs
@@ -23,7 +23,7 @@ use crate::events::{EventDispatch, EventLoop};
 use crate::message::ControlMessage;
 use crate::node::ChannelInterpretation;
 use crate::render::AudioWorkletGlobalScope;
-use crate::stats::{AudioStats, RenderReport};
+use crate::stats::{AudioStats, Observer, RenderReport};
 use crate::RENDER_QUANTUM_SIZE;
 
 use super::graph::Graph;
@@ -434,10 +434,10 @@ impl RenderThread {
             // SAFETY: potentially risky - "modifying the masking flags, rounding mode, or
             // denormals-are-zero mode flags leads to immediate Undefined Behavior: Rust assumes
             // that these are always in their default state and will optimize accordingly."
-            no_denormals::no_denormals(|| self.render_inner(output_buffer))
+            no_denormals::no_denormals(|| self.render_inner(output_buffer, observer.as_deref()))
         };
         #[cfg(not(any(target_arch = "x86", target_arch = "x86_64", target_arch = "aarch64")))]
-        self.render_inner(output_buffer);
+        self.render_inner(output_buffer, observer.as_deref());
 
         let render_duration_ns = render_start.elapsed().as_nanos().min(u128::from(u64::MAX)) as u64;
         let callback_budget_ns = if self.sample_rate <= 0. {
@@ -463,7 +463,11 @@ impl RenderThread {
         }
     }
 
-    fn render_inner<S: FromSample<f32> + Clone>(&mut self, mut output_buffer: &mut [S]) {
+    fn render_inner<S: FromSample<f32> + Clone>(
+        &mut self,
+        mut output_buffer: &mut [S],
+        observer: Option<&Observer>,
+    ) {
         self.buffer_size = output_buffer.len();
 
         // There may be audio frames left over from the previous render call,
@@ -515,6 +519,9 @@ impl RenderThread {
             let current_frame = self
                 .frames_played
                 .fetch_add(RENDER_QUANTUM_SIZE as u64, Ordering::Relaxed);
+            if let Some(observer) = observer {
+                observer.0.frame(current_frame + RENDER_QUANTUM_SIZE as u64);
+            }
             let current_time = current_frame as f64 / self.sample_rate as f64;
 
             let scope = AudioWorkletGlobalScope {
diff --git a/src/stats.rs b/src/stats.rs
index 1392e0b..7826b5e 100644
--- a/src/stats.rs
+++ b/src/stats.rs
@@ -24,6 +24,10 @@ pub struct RenderReport<'a> {
 /// Sees every callback's output on the render thread. It must not block or allocate.
 pub trait RenderObserver: Send + Sync {
     fn rendered(&self, report: &RenderReport<'_>);
+
+    /// Sees the context's frame count each time a render quantum begins, the value `currentTime` reads from then
+    /// on, so an embedder can publish `currentTime` where its control thread reads it without a call.
+    fn frame(&self, _frames_played: u64) {}
 }
 
 pub(crate) struct Observer(pub Box<dyn RenderObserver>);
