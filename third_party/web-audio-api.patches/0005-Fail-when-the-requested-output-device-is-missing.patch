From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Morris <masonmorris8@gmail.com>
Date: Thu, 12 Nov 2026 03:24:32 -0500
Subject: [PATCH 5/8] Fail when the requested output device is missing

An AudioContext with a sink id that names no device opened the default
output instead. That sends audio meant for one device to another, and the
spec has the constructor fail with an unknown sink id. Return the
DeviceUnavailable error instead.
---
 src/io/cpal.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/io/cpal.rs b/src/io/cpal.rs
index c3089ba..6be4071 100644
--- a/src/io/cpal.rs
+++ b/src/io/cpal.rs
@@ -227,14 +227,15 @@ impl AudioBackendManager for CpalBackend {
                 )
             })?
         } else {
+            // An unknown sink id is an error, never the default device, so audio meant for one
+            // device does not reach another.
             cpal_device_for_id(&host, MediaDeviceInfoKind::AudioOutput, &options.sink_id)?
-                .or_else(|| host.default_output_device())
                 .ok_or_else(|| {
                     AudioBackendError::new(
                         AudioBackendErrorKind::DeviceUnavailable,
                         "cpal",
                         "select_output_device",
-                        "No output device available",
+                        "No output device has the requested sink id",
                     )
                 })?
         };
