+    pub(crate) fn set_observer(&self, observer: Option<Box<dyn RenderObserver>>) {
+        self.inner
+            .observer
+            .store(observer.map(|o| Arc::new(Observer(o))));
+    }
+
+    pub(crate) fn observer(&self) -> Option<Arc<Observer>> {
+        self.inner.observer.load_full()
+    }
